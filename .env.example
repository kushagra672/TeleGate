# ==============================================================================
# Telegram API Credentials (Get from https://my.telegram.org)
# ==============================================================================
API_ID=12345678
API_HASH=your_telegram_api_hash_here

# ==============================================================================
# Telegram Bot Token (Get from @BotFather on Telegram)
# ==============================================================================
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# ==============================================================================
# Pyrogram String Session (Optional: Userbot session for premium emojis / fallback)
# Leave blank if only using Bot API
# ==============================================================================
STRING_SESSION=

# ==============================================================================
# Database Configuration (MongoDB URI)
# Example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
# ==============================================================================
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority

# ==============================================================================
# Telegram Administration & Routing
# ==============================================================================
# Admin Group or Channel Chat ID(s) where user support chats & live proxies are routed (comma-separated if multiple)
ADMIN_CHAT_ID=-1001234567890

# Admin Telegram User ID(s) authorized to access the /admin panel (comma-separated if multiple)
ADMIN_IDS=123456789,987654321

# Channel ID where Join Requests are monitored and auto-accepted (e.g. -100...)
CHANNEL_ID=-1001234567890

# Template Channel ID where dynamic funnel/broadcast templates are stored
TEMPLATE_CHANNEL_ID=-1009876543210

# ==============================================================================
# Optional: Custom Premium Emoji IDs (Telegram Premium custom emoji IDs)
# ==============================================================================
EMOJI_VIP=
EMOJI_SURESHOT=
EMOJI_NUMBERSHOT=
EMOJI_HACK=
EMOJI_CHALLENGE=
